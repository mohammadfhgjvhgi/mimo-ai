// MiMo — Prisma Domain Schema
// Phase 1: Database Foundation + Phase 116: Development Workspace
// Based on architecture/MiMo_Domain_Model.md + architecture/MiMo_Data_Architecture.md
// SQLite + Prisma — local-first, single-user

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════════════════════════════
// Core Domain Entities
// ════════════════════════════════════════════════════════════════

/// A project is the ONLY container in MiMo (Product Bible Part 2.5).
/// One per long-running effort. Each has accent, MIMO.md, scoped memory.
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  accent      String   @default("#7c3aed")
  mimoMdPath  String?  // path to MIMO.md grounding file
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conversations  Conversation[]
  memories       Memory[]
  artifacts      Artifact[]
  files          File[]
  tasks          Task[]
  settings       ProjectSetting[]
}

/// A conversation is the permanent spine (Product Bible Part 2.6).
/// Pinned tab #1, never deleted. Contains messages.
model Conversation {
  id        String   @id @default(cuid())
  projectId String?
  title     String   @default("محادثة جديدة")
  pinned    Boolean  @default(false)
  forkedFrom String?  // parent conversation ID if forked
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([projectId])
}

/// A message within a conversation (user or AI).
model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // 'user' | 'ai'
  content        String
  mode           String?  // chat/research/code/etc
  model          String?  // which model was used
  thinking       Boolean  @default(false)
  research       Boolean  @default(false)
  streaming      Boolean  @default(false)
  error          String?
  tokenCount     Int?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

// ════════════════════════════════════════════════════════════════
// Memory (Product Bible Part 5)
// ════════════════════════════════════════════════════════════════

/// Memory entries — persisted. Two-layer: explicit saved + implicit reference.
/// Every memory has: source, timestamp, type, confidence, delete.
/// metadata: JSON-encoded Record<string, unknown> (Phase 116 fix: previously dropped).
model Memory {
  id          String   @id @default(cuid())
  type        String   // fact | preference | event | relation | skill | goal
  content     String
  scope       String   @default("global") // 'global' | 'project' | 'conversation' | 'temporary'
  projectId   String?
  source      String   // 'user' | 'agent:<id>' | 'tool:<id>' | 'conversation:<id>'
  confidence  Float    @default(0.5)
  metadata    String?  // JSON-encoded Record<string, unknown>
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? // soft delete

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([type, content, scope])
  @@index([type])
  @@index([projectId])
  @@index([scope])
  @@index([deletedAt])
  @@index([createdAt])
}

// ════════════════════════════════════════════════════════════════
// Knowledge Graph (Product Bible Part 6)
// Phase 116: migrated from raw SQL to proper Prisma models so they
// are under migration control and benefit from type-safe queries.
// ════════════════════════════════════════════════════════════════

/// A knowledge entity — a node in the personal knowledge graph.
model KnowledgeEntity {
  id            String   @id @default(cuid())
  name          String
  type          String   // person | project | technology | concept | place | organization | event | skill | goal | artifact
  description   String?
  confidence    Float    @default(0.5)
  evidenceCount Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type])
  @@index([name])
}

/// A relationship between two knowledge entities — an edge in the graph.
model KnowledgeRelationship {
  id          String   @id @default(cuid())
  fromEntityId String
  toEntityId   String
  type        String   // related_to | depends_on | created | uses | part_of | knows | etc
  confidence  Float    @default(0.5)
  createdAt   DateTime @default(now())

  @@unique([fromEntityId, toEntityId, type])
  @@index([fromEntityId])
  @@index([toEntityId])
  @@index([type])
}

// ════════════════════════════════════════════════════════════════
// Artifacts (Product Bible Part 11)
// ════════════════════════════════════════════════════════════════

/// Artifacts are first-class objects (code/markdown/image/diagram/etc).
model Artifact {
  id          String   @id @default(cuid())
  type        String   // code | markdown | image | diagram | research | plan | etc
  title       String
  content     String   // or path to external content
  projectId   String?
  provenance  String?  // conversation:agent:model that produced it
  version     Int      @default(1)
  parentId    String?  // previous version
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([type])
}

// ════════════════════════════════════════════════════════════════
// Tasks (Product Bible Part 2.7)
// ════════════════════════════════════════════════════════════════

/// A task is a unit of agent work within a conversation.
model Task {
  id             String   @id @default(cuid())
  projectId      String?
  conversationId String?
  status         String   @default("pending") // pending|planning|executing|validating|done|error|cancelled
  intent         String?
  plan           String?  // JSON plan
  progress       Float    @default(0)
  agentId        String?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  completedAt    DateTime?

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
}

// ════════════════════════════════════════════════════════════════
// Events (Product Bible Part 29 — audit log, append-only)
// ════════════════════════════════════════════════════════════════

/// Append-only event log. Every meaningful action is logged.
/// Never deleted. Used for audit trail + observability.
model EventLog {
  id            String   @id @default(cuid())
  type          String   // USER_MESSAGE_CREATED | AGENT_STARTED | etc
  source        String   // which module emitted
  payload       String   // JSON
  correlationId String?
  timestamp     DateTime @default(now())

  @@index([type])
  @@index([correlationId])
  @@index([timestamp])
}

// ════════════════════════════════════════════════════════════════
// Files (virtual FS scoped to project — legacy life-side files)
// ════════════════════════════════════════════════════════════════

model File {
  id        String   @id @default(cuid())
  projectId String?
  name      String
  path      String
  size      Int?
  mimeType  String?
  content   String?  // text content (for small files)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

// ════════════════════════════════════════════════════════════════
// Project Settings
// ════════════════════════════════════════════════════════════════

model ProjectSetting {
  id        String   @id @default(cuid())
  projectId String
  key       String
  value     String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@index([projectId])
}

// ════════════════════════════════════════════════════════════════
// DEVELOPMENT WORKSPACE (Phase 116 — Built-in Project Sandbox)
// ════════════════════════════════════════════════════════════════
// A self-contained development environment inside MiMo. Each DevProject
// is an isolated code project with files, build artifacts, test runs,
// process tracking, snapshots, and per-project permissions. All
// execution flows through RuntimeGateway → SandboxManager (never the
// host directly).

/// A development project — isolated workspace with sandboxed execution.
model DevProject {
  id          String   @id @default(cuid())
  name        String
  description String?
  /// Project type — drives build/test commands. Detected or set explicitly.
  type        String   @default("generic") // nextjs | node | python | static | generic
  /// Absolute path to the project root inside the sandbox root.
  rootPath    String
  /// Sandbox profile — controls filesystem/network/process limits.
  profile     String   @default("standard") // safe | standard | development | networked | restricted
  /// Default runtime — used by BuildSystem + TestRunner.
  runtime     String   @default("node") // node | bun | python | static
  /// Package manager used for install.
  packageManager String @default("npm") // npm | yarn | pnpm | bun | pip
  status      String   @default("idle") // idle | building | running | testing | error | archived
  /// Last detected git branch (if any).
  gitBranch   String?
  /// Last build result summary.
  lastBuild   String?  // JSON: { status, durationMs, errors, warnings, timestamp }
  /// Last test result summary.
  lastTest    String?  // JSON: { passed, failed, skipped, durationMs, timestamp }
  /// Preview port (if running).
  previewPort Int?
  /// Environment variables as JSON: { KEY: { configured: bool, required: bool, status: 'configured'|'missing'|'invalid' } }
  /// NEVER stores secret values — only status flags.
  envStatus   String?  // JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  archivedAt  DateTime?

  files       DevFile[]
  builds      DevBuild[]
  testRuns    DevTestRun[]
  logs        DevLog[]
  snapshots   DevSnapshot[]
  permissions DevPermission[]
  processes   DevProcess[]

  @@index([status])
  @@index([type])
}

/// A file or directory inside a DevProject sandbox.
/// Path is RELATIVE to the project root (validated against traversal).
model DevFile {
  id        String   @id @default(cuid())
  projectId String
  /// Relative path from project root — validated to reject '..' and absolute paths.
  path      String
  name      String
  isDirectory Boolean @default(false)
  size      Int      @default(0)
  mimeType  String?
  /// Content hash (sha256 hex) for change detection.
  hash      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project DevProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([projectId])
  @@index([path])
}

/// A build run for a DevProject.
model DevBuild {
  id         String   @id @default(cuid())
  projectId  String
  status     String   @default("pending") // pending | running | success | failed | cancelled
  command    String   // the build command that was run
  output     String   @default("") // build log output (truncated)
  errors     String?  // JSON array of error lines
  warnings   String?  // JSON array of warning lines
  durationMs Int?
  exitCode   Int?
  startedAt  DateTime @default(now())
  finishedAt DateTime?

  project DevProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([startedAt])
}

/// A test run for a DevProject.
model DevTestRun {
  id         String   @id @default(cuid())
  projectId  String
  status     String   @default("pending") // pending | running | passed | failed | cancelled
  command    String
  passed     Int      @default(0)
  failed     Int      @default(0)
  skipped    Int      @default(0)
  durationMs Int?
  output     String   @default("")
  startedAt  DateTime @default(now())
  finishedAt DateTime?

  project DevProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([startedAt])
}

/// A log entry for a DevProject — build/runtime/terminal/test/agent/security/network.
model DevLog {
  id            String   @id @default(cuid())
  projectId     String
  /// Log channel.
  channel       String   // build | runtime | terminal | test | agent | security | network
  level         String   @default("info") // debug | info | warn | error
  message       String
  /// Process ID (if from a tracked process).
  processId     String?
  /// Correlation ID (for cross-referencing with EventLog).
  correlationId String?
  /// Sanitized metadata (no secrets — redacted before storage).
  metadata      String?  // JSON
  timestamp     DateTime @default(now())

  project DevProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, channel])
  @@index([level])
  @@index([timestamp])
}

/// A tracked process running inside a DevProject sandbox.
model DevProcess {
  id         String   @id @default(cuid())
  projectId  String
  pid        Int?     // OS PID if available
  command    String
  status     String   @default("running") // running | exited | killed | crashed
  exitCode   Int?
  startedAt  DateTime @default(now())
  finishedAt DateTime?

  project DevProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

/// A versioned snapshot of a DevProject (files + metadata).
/// Used for snapshot/restore/clone.
model DevSnapshot {
  id         String   @id @default(cuid())
  projectId  String
  label      String
  description String?
  /// Absolute path to the snapshot archive (tar.gz) inside the snapshots dir.
  archivePath String
  /// SHA-256 of the archive (integrity check).
  hash       String
  /// File count at snapshot time.
  fileCount  Int
  /// Total size in bytes.
  sizeBytes  Int
  createdAt  DateTime @default(now())

  project DevProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
}

/// A per-project permission grant. Default: DENY. Explicit grants only.
model DevPermission {
  id         String   @id @default(cuid())
  projectId  String
  /// Permission key (e.g., filesystem.read, process.execute, network.access).
  permission String
  /// Grant status: allow | deny | ask.
  status     String   @default("ask")
  /// Who granted it.
  grantedBy  String   @default("user") // user | system
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project DevProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, permission])
  @@index([projectId])
}

// ════════════════════════════════════════════════════════════════
// SCHEDULER & AUTOMATION (from remote repo)
// ════════════════════════════════════════════════════════════════

model Schedule {
  id          String   @id @default(cuid())
  name        String
  description String?
  prompt      String   // the prompt to execute at the scheduled time
  cronExpression String? // e.g. "0 8 * * *" for daily at 8am
  nextRunAt   DateTime?
  lastRunAt   DateTime?
  isActive    Boolean  @default(true)
  maxRuns     Int?     // null = unlimited
  runsCount   Int      @default(0)
  requiresApproval Boolean @default(false)
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, nextRunAt])
}

// ════════════════════════════════════════════════════════════════
// TOOLS & TOOL CALLS (observability)
// ════════════════════════════════════════════════════════════════

model ToolCall {
  id          String   @id @default(cuid())
  traceId     String?
  toolName    String   // "web_search", "file_read", "task_create", etc.
  input       String   // JSON input args
  output      String?  // JSON output
  status      String   @default("pending") // "pending", "running", "success", "error", "cancelled"
  errorMessage String?
  durationMs  Int      @default(0)
  tokensUsed  Int      @default(0)
  costUsd     Float    @default(0)
  requiresApproval Boolean @default(false)
  approved    Boolean  @default(false)
  approvedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([toolName])
  @@index([createdAt])
  @@index([traceId])
}

model Skill {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String?  // "coding", "research", "writing", "automation"
  triggerPattern String? // regex or keyword
  procedure   String   // JSON workflow steps
  examples    String?  // JSON array of usage examples
  successCount Int     @default(0)
  failureCount Int     @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

// ════════════════════════════════════════════════════════════════
// TRACES & OBSERVABILITY
// ════════════════════════════════════════════════════════════════

model Trace {
  id          String   @id @default(cuid())
  conversationId String?
  traceType   String   // "agent_run", "tool_chain", "memory_op", "kg_op"
  title       String
  description String?
  status      String   @default("pending") // "pending", "running", "completed", "failed"
  steps       String?  // JSON array of step objects
  totalDurationMs Int  @default(0)
  totalTokens Int      @default(0)
  totalCostUsd Float   @default(0)
  errorMessage String?
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([traceType])
  @@index([conversationId])
}

// ════════════════════════════════════════════════════════════════
// APPROVALS (Human-in-the-Loop)
// ════════════════════════════════════════════════════════════════

model ApprovalRequest {
  id          String   @id @default(cuid())
  taskId      String?
  traceId     String?
  action      String   // description of action to approve
  actionType  String   // "file_delete", "send_email", "execute_code", "external_call"
  payload     String?  // JSON details
  status      String   @default("pending") // "pending", "approved", "rejected", "expired"
  reason      String?  // why approval is needed
  decidedAt   DateTime?
  decidedBy   String?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([status])
  @@index([taskId])
}

// ════════════════════════════════════════════════════════════════
// FAILURE MEMORY (Reflexion Pattern — Self-Improvement)
// Based on: arXiv:2509.25370 (ICML 2025) — "Where LLM Agents Fail"
// ════════════════════════════════════════════════════════════════

model FailureMemory {
  id              String   @id @default(cuid())
  traceId         String?
  conversationId  String?
  taskDescription String   // what was the user trying to do
  attemptedPlan   String?  // JSON: steps the agent tried
  failurePoint    String?  // which step failed
  errorType       String?  // from taxonomy: arithmetic, logical, hallucination, plan_omission, tool_error
  errorMessage    String?  // raw error message
  rootCauseAnalysis String? // LLM-generated root cause
  proposedFix     String?  // LLM-generated fix
  appliedFix      Boolean  @default(false) // was the fix applied successfully?
  embedding       String?  // for semantic retrieval
  metadata        String?  // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdAt])
  @@index([errorType])
  @@index([traceId])
}

// ════════════════════════════════════════════════════════════════
// PREFERENCES
// ════════════════════════════════════════════════════════════════

model Preference {
  id        String   @id @default(cuid())
  key       String   // e.g. "tone", "response_length", "language_style"
  value     String   // JSON-encoded value
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key])
}
